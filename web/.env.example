NEXT_PUBLIC_SOLANA_RPC_URL=http://127.0.0.1:8899
# Set this to the address in the generated IDL and the actual deployment.
NEXT_PUBLIC_MANDATEOS_PROGRAM_ID=
# Optional public organization address to open initially.
NEXT_PUBLIC_MANDATEOS_ORGANIZATION=
# Disposable demo signing is permitted only for localhost RPC, when enabled.
NEXT_PUBLIC_ENABLE_LOCAL_DEMO=true
